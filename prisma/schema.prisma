generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionType {
  LETTER
  MEMORY
  FANMADE
  CALL
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
}

model Submission {
  id            String           @id @default(uuid())
  type          SubmissionType
  authorName    String
  targetId      String?
  title         String?
  content       String           @db.Text
  mediaUrl      String?
  mediaType     MediaType?
  mediaItems    Json?
  proofUrl      String?
  proofFileName String?
  status        SubmissionStatus @default(PENDING)
  adminNote     String?          @db.Text
  likesCount    Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, type, createdAt])
  @@index([targetId])
}

model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model ArtistGuide {
  id         String   @id @default(uuid())
  artistSlug String   @unique
  role       String?
  imageUrl   String?
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GlossaryTerm {
  id         String   @id @default(uuid())
  term       String   @unique
  definition String   @db.Text
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sortOrder])
}

model EpisodeGuide {
  id            String   @id @default(uuid())
  episodeNumber Int      @unique
  title         String
  description   String?  @db.Text
  imageUrl      String
  youtubeUrl    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([episodeNumber])
}
