# PostgreSQL (Neon/Supabase pooled connection recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Cloudinary direct signed upload (recommended)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Optional unsigned fallback. Restrict file types and sizes in Cloudinary.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Admin session and password (replace before deployment)
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Public date/time for the next episode countdown (ISO-8601)
NEXT_PUBLIC_NEXT_EPISODE_AT="2026-09-19T20:00:00+07:00"
